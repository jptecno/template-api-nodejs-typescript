{
  "name": "{{projectName}}",
  "version": "0.1.0",
  "description": "{{description}}",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run validate:template-contract && npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "validate:template-contract": "node scripts/validate-template-contract.mjs",
    "start": "node dist/main.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@testcontainers/postgresql": "^12.1.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.1.0",
    "@types/pg": "^8.20.4",
    "ajv": "^8.20.0",
    "danger": "13.0.10",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.0",
    "fastify": "^5.11.2",
    "kysely": "^0.29.4",
    "pg": "^8.22.0",
    "undici": "^8.10.0"
  }
}
