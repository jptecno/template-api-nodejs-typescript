{
  "schemaVersion": 1,
  "id": "api-nodejs-typescript",
  "name": "API Node.js + TypeScript",
  "description": "Fastify, PostgreSQL, Kysely, Vitest e Biome.",
  "repository": "jptecno/template-api-nodejs-typescript",
  "variables": [
    {
      "name": "projectName",
      "prompt": "Nome do projeto",
      "required": true,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    {
      "name": "description",
      "prompt": "Descrição do projeto",
      "required": false,
      "default": "API criada a partir do template da JP Tecno"
    }
  ],
  "render": {
    "include": [
      "package.json",
      "package-lock.json",
      ".env.example",
      "README.md"
    ]
  },
  "toolchain": {
    "ecosystem": "node",
    "requirements": [
      {
        "tool": "node",
        "minimumVersion": "24.0.0"
      },
      {
        "tool": "npm",
        "minimumVersion": "11.0.0"
      }
    ],
    "steps": {
      "install": {
        "command": "npm",
        "args": ["install"],
        "dependsOn": [],
        "recommended": true
      },
      "formatCheck": {
        "command": "npm",
        "args": ["run", "format:check"],
        "dependsOn": ["install"],
        "recommended": true
      },
      "lint": {
        "command": "npm",
        "args": ["run", "lint"],
        "dependsOn": ["formatCheck"],
        "recommended": true
      },
      "typecheck": {
        "command": "npm",
        "args": ["run", "typecheck"],
        "dependsOn": ["lint"],
        "recommended": true
      },
      "test": {
        "command": "npm",
        "args": ["test"],
        "dependsOn": ["typecheck"],
        "recommended": true
      },
      "build": {
        "command": "npm",
        "args": ["run", "build"],
        "dependsOn": ["test"],
        "recommended": true
      }
    }
  }
}
